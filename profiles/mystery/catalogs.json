          "progressive_revelation": 9,
          "unknown_rules": 9,
          "revelation_frequency": 8,
          "containment": 7
        },
        "penalties": {
          "drama_focus": 4
        }
      }
    },
    {
      "id": "high-suspense",
      "name": "⚡ High Suspense",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 60,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [
            { "dimension": "suspense", "at_or_above": 8 },
            { "dimension": "revelation_frequency", "at_or_above": 6 }
          ],
          "any_of": []
        },
        "weights": {
          "suspense": 15,
          "revelation_frequency": 11,
