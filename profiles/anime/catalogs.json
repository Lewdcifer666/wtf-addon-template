{
  "schema_version": 2,
  "manifest": {
    "id": "com.github.wtfanime.discovery",
    "version": "1.0.0",
    "name": "WTF Anime Discovery",
    "description": "Automated anime built on out-thinking and hidden truth: psychological strategy, cat-and-mouse, deep power systems and visible progression, supernatural and strange worlds - with horror, gore and brutality treated as wanted properties rather than costs."
  },
  "site": {
    "title": "WTF Anime Discovery",
    "emoji": "🧠",
    "blurb": "Automated Stremio catalogs for anime that out-thinks you: psychological strategy and cat-and-mouse, mysteries that keep paying out, deep power systems and real progression, strange worlds - and gore, horror and brutality as features, not warnings."
  },
  "catalogs": [
    { "id": "full-watchlist", "name": "Full Watchlist", "filter": "watch", "sort": "score" },
    { "id": "past-24h", "name": "🔥 Past 24h Findings", "filter": "past24", "sort": "newest" },
    { "id": "best-matches", "name": "⭐ Best Matches", "filter": "best", "sort": "score" },
    {
      "id": "dna-match",
      "name": "🧬 DNA Match",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 50,
      "dna": { "mode": "baseline_profile", "archetype_bonus_max": 25 }
    },
    {
      "id": "psychological-mystery",
      "name": "🧠 Psychological Mystery",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [],
          "any_of": [
            { "dimension": "psychological_strategy", "at_or_above": 6 },
            { "dimension": "cat_and_mouse", "at_or_above": 6 }
          ]
        },
        "weights": {
          "psychological_strategy": 14,
          "cat_and_mouse": 12,
          "mystery": 11,
          "deception": 9,
          "plot_twists": 8,
          "progressive_revelation": 8
        },
        "penalties": { "slice_of_life": 6, "romance_focus": 5 }
      }
    },
    {
      "id": "powers-progression",
      "name": "🔥 Powers & Progression",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [],
          "any_of": [
            { "dimension": "power_progression", "at_or_above": 6 },
            { "dimension": "power_system_depth", "at_or_above": 6 },
            { "dimension": "magic_presence", "at_or_above": 6 }
          ]
        },
        "weights": {
          "power_progression": 13,
          "power_system_depth": 12,
          "ability_variety": 11,
          "training_growth": 8,
          "power_escalation": 8,
          "magic_presence": 8,
          "action_density": 6
        },
        "penalties": { "romance_focus": 5, "sports_focus": 6 }
      }
    },
    {
      "id": "dark-supernatural",
      "name": "👹 Dark Supernatural",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [ { "dimension": "supernatural", "at_or_above": 6 } ],
          "any_of": []
        },
        "weights": {
          "supernatural": 13,
          "dark_tone": 11,
          "creature_threat": 9,
          "ability_variety": 8,
          "horror": 7,
          "action_density": 6
        },
        "penalties": { "slice_of_life": 6, "romance_focus": 5 }
      }
    },
    {
      "id": "gore-horror",
      "name": "🩸 Gore / Horror",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [],
          "any_of": [
            { "dimension": "gore", "at_or_above": 6 },
            { "dimension": "horror", "at_or_above": 6 }
          ]
        },
        "weights": {
          "gore": 14,
          "horror": 13,
          "brutality": 11,
          "dark_tone": 9,
          "creature_threat": 6,
          "visual_uniqueness": 5
        },
        "penalties": { "slice_of_life": 6, "comedy": 4 }
      }
    },
    {
      "id": "scifi-reality-weirdness",
      "name": "🛰️ Sci-Fi & Reality Weirdness",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [],
          "any_of": [
            { "dimension": "sci_fi_elements", "at_or_above": 5 },
            { "dimension": "reality_anomaly", "at_or_above": 5 }
          ]
        },
        "weights": {
          "sci_fi_elements": 13,
          "reality_anomaly": 12,
          "weirdness": 10,
          "mystery": 9,
          "progressive_revelation": 8,
          "psychological_strategy": 6
        },
        "penalties": { "mecha_focus": 7, "military_focus": 6 }
      }
    },
    {
      "id": "strange-worlds",
      "name": "🌌 Strange Worlds",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [],
          "any_of": [
            { "dimension": "strange_world", "at_or_above": 6 },
            { "dimension": "adventure", "at_or_above": 7 }
          ]
        },
        "weights": {
          "strange_world": 13,
          "adventure": 11,
          "worldbuilding": 11,
          "weirdness": 8,
          "dark_tone": 6,
          "creature_threat": 5
        },
        "penalties": { "slice_of_life": 6, "romance_focus": 5 }
      }
    },
    {
      "id": "wtf-comedy",
      "name": "🤯 WTF Comedy",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 50,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [ { "dimension": "wtf_comedy", "at_or_above": 6 } ],
          "any_of": []
        },
        "weights": {
          "wtf_comedy": 15,
          "weirdness": 11,
          "overpowered_protagonist": 7,
          "action_density": 6,
          "visual_uniqueness": 5
        },
        "penalties": { "slice_of_life": 7, "romance_focus": 5 }
      }
    },
    {
      "id": "high-action",
      "name": "⚔️ High Action",
      "filter": "dna",
      "sort": "dna_score",
      "min_score": 55,
      "dna": {
        "mode": "weighted",
        "gate": {
          "all_of": [ { "dimension": "action_density", "at_or_above": 7 } ],
          "any_of": []
        },
        "weights": {
          "action_density": 14,
          "action_intensity": 9,
          "ability_variety": 8,
          "power_escalation": 7,
          "visual_quality": 6
        },
        "penalties": { "sports_focus": 8, "mecha_focus": 7, "drama_focus": 4 }
      }
    }
  ]
}
