{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "invocation_id", "session_id", "use_id", "context_hash", "provider_id", "query", "preference_indexes", "provider_request_id", "sources"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "private_observed_research_search"},
    "invocation_id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "session_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "use_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "preference_indexes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "provider_request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "sources": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["url", "title"],
      "properties": {"url": {"type": "string", "minLength": 1, "maxLength": 4096}, "title": {"type": "string", "maxLength": 1024}}
    }}
  }
}
